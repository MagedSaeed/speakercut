{
  "manifest_version": 3,
  "name": "SpeakerCut",
  "version": "0.3.0",
  "description": "SpeakerCut: one-click speaker-diarization presegmentation for Label Studio. Adds draft segments only; never submits.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://annotation.dlnlp.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SpeakerCut settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://annotation.dlnlp.ai/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://annotation.dlnlp.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "short_name": "SpeakerCut",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon32.png"
      ],
      "matches": [
        "https://annotation.dlnlp.ai/*"
      ]
    }
  ]
}