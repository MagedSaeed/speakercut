# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines: Docker's --env-file does not strip trailing comments or quotes.
# Hugging Face token (read access) with the model terms accepted at
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Optional: alternative model, e.g. pyannote/speaker-diarization-3.1
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# ---- Optional paid providers (choose in the extension popup) ----
# pyannoteAI (https://dashboard.pyannote.ai) - strongest diarization
# PYANNOTEAI_API_KEY=
# Model: precision-2 or precision-3
# PYANNOTEAI_MODEL=precision-2
